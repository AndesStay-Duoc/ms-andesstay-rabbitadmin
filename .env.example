# Copiar a .env y completar. El archivo .env NO se versiona.

# --- Identidad (Entra ID). No son secretos: son identificadores publicos del App Registration ---
AZURE_TENANT_ID=055d11d1-8ae0-4221-a6f7-b50be0a623b4
AZURE_CLIENT_ID=704a544f-3d92-44f5-aef9-8559574cff34

# --- RabbitMQ (AMQP): declarar y eliminar colas, exchanges y bindings ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=andesstay
RABBITMQ_USER=andesstay
RABBITMQ_PASS=cambiar_esto

# --- API de gestión de RabbitMQ (HTTP): listados y lectura de argumentos y bindings.
#     Usa el mismo usuario y contraseña de arriba ---
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_TIMEOUT_MS=5000

# --- Recursos protegidos: el administrador no puede crearlos, modificarlos ni eliminarlos.
#     Nombre exacto o prefijo terminado en '*' (abarca cualquier sufijo, puntos incluidos).
#     Varias entradas separadas por comas ---
RABBITADMIN_COLAS_PROTEGIDAS=q.cmd.*
RABBITADMIN_EXCHANGES_PROTEGIDOS=cmd.*
